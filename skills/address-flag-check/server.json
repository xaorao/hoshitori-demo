{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.OWNER/address-flag-check",
  "title": "Address flag check",
  "description": "Is an address on OFAC's SDN list or frozen by USDT or USDC? Absence is never called safe",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "address-flag-check",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
