{
  "name": "Hoshitori",
  "colours": {
    "paper": {
      "role": "the page",
      "light": "#ffffff",
      "dark": "#0b0b0c"
    },
    "halo": {
      "role": "a warm surface",
      "light": "#fafaf7",
      "dark": "#111113"
    },
    "veil": {
      "role": "cards and fields",
      "light": "#f8fafc",
      "dark": "#141417"
    },
    "line": {
      "role": "1 px borders",
      "light": "#e5e7eb",
      "dark": "#2a2a2e"
    },
    "fog": {
      "role": "decoration only, never text",
      "light": "#9ca3af",
      "dark": "#8a8f98"
    },
    "graphite": {
      "role": "secondary text",
      "light": "#4b5563",
      "dark": "#b4b9c2"
    },
    "stone": {
      "role": "body text",
      "light": "#1d1d1f",
      "dark": "#e6e6e8"
    },
    "ink": {
      "role": "headlines, the primary button, the mark",
      "light": "#0a0a0a",
      "dark": "#f5f5f6"
    },
    "accent": {
      "role": "independently verified, and settled outcomes; nothing else",
      "light": "#047857",
      "dark": "#34d399"
    },
    "accent-soft": {
      "role": "the ground of a verified pill",
      "light": "#e7f6ef",
      "dark": "#0f2a21"
    },
    "redline": {
      "role": "risk and failure",
      "light": "#b45309",
      "dark": "#f59e0b"
    },
    "redline-soft": {
      "role": "the ground of a failure pill",
      "light": "#fff4e5",
      "dark": "#2a1d08"
    },
    "focus": {
      "role": "the keyboard focus ring",
      "light": "#1d4ed8",
      "dark": "#93c5fd"
    }
  },
  "contrast": [
    {
      "foreground": "stone",
      "background": "paper",
      "use": "body text",
      "minimum": 4.5,
      "light": 16.83,
      "dark": 15.78
    },
    {
      "foreground": "ink",
      "background": "paper",
      "use": "headlines",
      "minimum": 4.5,
      "light": 19.8,
      "dark": 18.06
    },
    {
      "foreground": "graphite",
      "background": "paper",
      "use": "secondary text",
      "minimum": 4.5,
      "light": 7.56,
      "dark": 9.99
    },
    {
      "foreground": "graphite",
      "background": "veil",
      "use": "secondary text on a card",
      "minimum": 4.5,
      "light": 7.22,
      "dark": 9.33
    },
    {
      "foreground": "accent",
      "background": "paper",
      "use": "verified and settled marks",
      "minimum": 4.5,
      "light": 5.48,
      "dark": 10.23
    },
    {
      "foreground": "accent",
      "background": "accent-soft",
      "use": "a verified pill",
      "minimum": 4.5,
      "light": 4.92,
      "dark": 7.95
    },
    {
      "foreground": "redline",
      "background": "paper",
      "use": "risk and failure marks",
      "minimum": 4.5,
      "light": 5.02,
      "dark": 9.16
    },
    {
      "foreground": "redline",
      "background": "redline-soft",
      "use": "a failure pill",
      "minimum": 4.5,
      "light": 4.62,
      "dark": 7.65
    },
    {
      "foreground": "paper",
      "background": "ink",
      "use": "text on the ink button",
      "minimum": 4.5,
      "light": 19.8,
      "dark": 18.06
    },
    {
      "foreground": "focus",
      "background": "paper",
      "use": "the focus ring",
      "minimum": 3.0,
      "light": 6.7,
      "dark": 10.91
    }
  ],
  "type": {
    "sans": "system-ui stack, weights 400 and 800",
    "mono": "ui-monospace stack, for ids, hashes, levels and kickers"
  },
  "radii": {
    "small": "4px",
    "medium": "6px",
    "pill": "999px"
  }
}
