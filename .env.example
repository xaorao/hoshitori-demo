# Copy to .env and fill in what you use. Never commit .env. Nothing here is needed for the quickstart.

# RYO builder credential, read by the league when its settings turn RYO on (league_cli, ryo_transport). Server-side only.
RYO_MCP_KEY=

# A model behind an OpenAI-compatible endpoint, for the model agents, the Desk and the claim reader. The league reads the key from the
# variable its model settings name (key_env); the model scripts (scripts/probe_models.py, scripts/benchmark_models.py) read these two.
LLM_BASE_URL=
LLM_API_KEY=

# Optional: an X application bearer token, for `hoshitori-league signals` (public posts of the voices on the Voices and whales page).
X_BEARER_TOKEN=
